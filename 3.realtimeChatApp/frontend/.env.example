# Optional.
#
# In development the Vite dev server proxies /api, /uploads and /socket.io
# to http://localhost:5000, so you normally do NOT need this file.
#
# Set VITE_SERVER_URL when the frontend and backend are deployed on different
# origins (for example Vercel + Render). API calls use the current origin via
# Vercel rewrites; this value is used for the Socket.IO connection.
VITE_SERVER_URL=

# Optional: where the dev/preview proxy should send API traffic.
# BACKEND_URL=http://localhost:5000
