# Server
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Database (local, Docker, or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/chatly

# Auth - `npm run setup` generates a strong value automatically
JWT_SECRET=replace-with-a-long-random-secret

# Optional media storage.
# Leave these empty to store uploads in backend/public/uploads (no account needed).
CLOUD_NAME=
API_KEY=
API_SECRET=
